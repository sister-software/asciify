{
	"name": "@sister.software/asciify",
	"version": "4.2.1",
	"description": "Converts images, videos, and 3D renders into ASCII art.",
	"keywords": [
		"3d",
		"art",
		"ascii",
		"image",
		"rasterizer",
		"render",
		"three",
		"threejs",
		"video"
	],
	"homepage": "https://sister.software/asciify",
	"bugs": {
		"url": "https://github.com/sister-software/asciify/issues"
	},
	"license": "MIT",
	"author": "Teffen Ellis <teffen@sister.software>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sister-software/asciify.git"
	},
	"files": [
		"out/**/*"
	],
	"type": "module",
	"main": "./out/index.js",
	"module": "./out/index.js",
	"types": "./out/index.d.ts",
	"imports": {
		"#asciify": "./index.ts",
		"#tui": "./tui/index.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"import": "./out/index.js"
		},
		"./tui": {
			"types": "./out/tui/index.d.ts",
			"import": "./out/tui/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"check-types": "tsc --build .",
		"clean": "tsc -b --clean",
		"compile": "tsc -b",
		"demo": "http-server ./ -p 8081",
		"fix:oxlint": "oxlint --fix",
		"format": "oxfmt .",
		"lint": "run-s lint:oxlint lint:oxfmt",
		"lint:fix": "run-s fix:oxlint format",
		"lint:oxfmt": "oxfmt --check .",
		"lint:oxlint": "oxlint",
		"release": "yarn run compile && release-it",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sister.software/oxfmt-config": "^12.1.3",
		"@sister.software/oxlint-config": "^12.1.3",
		"@sister.software/tsconfig": "^12.1.3",
		"@types/node": "^26.2.0",
		"@types/semver": "^7.8.0",
		"@types/three": "^0.185.4",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"dat.gui": "^0.7.9",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"playwright": "^1.62.1",
		"release-it": "^21.0.2",
		"semver": "^7.8.5",
		"stats-js": "^1.0.1",
		"three": "^0.185.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">= 24.0.0"
	},
	"packageManager": "yarn@4.18.0"
}
